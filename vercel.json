{
  "rewrites": [
    { "source": "/parents.html", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*\\.css)", "destination": "/public/$1" },
    { "source": "/(.*\\.js)", "destination": "/public/$1" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
