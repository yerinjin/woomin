{
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/parents.html", "destination": "/api/parents" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*\\.css)", "destination": "/public/$1" },
    { "source": "/(.*\\.js)", "destination": "/public/$1" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
