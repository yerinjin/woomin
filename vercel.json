{
  "rewrites": [
    { "source": "/parents.html", "destination": "/api?route=parents" },
    { "source": "/api/yearly-trend", "destination": "/api?route=yearly-trend" },
    { "source": "/api/data", "destination": "/api?route=data" },
    { "source": "/(.*\\.css)", "destination": "/public/$1" },
    { "source": "/(.*\\.js)", "destination": "/public/$1" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
